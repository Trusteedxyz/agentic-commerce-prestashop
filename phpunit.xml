<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="agentic-tools">
            <directory>tests/AgenticTools</directory>
        </testsuite>
        <testsuite name="discovery">
            <directory>tests/discovery</directory>
        </testsuite>
        <!--
          Estado del alta (badge del back office + honestidad del mensaje de
          auto-registro). Lógica pura sobre tres cadenas: no declara stubs
          globales de PS, así que el directorio entero se puede registrar sin
          las colisiones que obligan a listar `enforcement` fichero a fichero.
        -->
        <testsuite name="admin">
            <directory>tests/admin</directory>
        </testsuite>
        <!--
          The rest of tests/enforcement is not wired up: those files define
          colliding PS global stubs (\Configuration::set, etc.) that the shared
          bootstrap already provides. Register this file individually rather
          than the whole directory.
        -->
        <testsuite name="enforcement-defaults">
            <file>tests/enforcement/FallbackModeDefaultTest.php</file>
        </testsuite>
        <!--
          P0-3 — rule-code normalisation. Kernel-free (no PS global stubs), so
          it could join a directory suite; registered as a file for the same
          reason as its neighbour above.
        -->
        <testsuite name="enforcement-rule-code">
            <file>tests/enforcement/RuleCodeTest.php</file>
        </testsuite>
        <!--
          Auditoría 2026-09-27 (A9/A8, plan 04 Task 8) — fixture cross-language
          del flujo principal + el flujo de ValidateOrderHook ejecutado con el
          SnapshotClient real y sus bordes de red sustituidos. Los stubs de PS
          del segundo fichero se declaran sólo si no existen y ninguna otra
          suite de este xml los declara.
        -->
        <testsuite name="enforcement-platform-flow">
            <file>tests/enforcement/PlatformFlowConformanceTest.php</file>
            <file>tests/enforcement/ValidateOrderHookAgenticFlowTest.php</file>
            <file>tests/enforcement/ValidateOrderHookDegradedFlowTest.php</file>
            <file>tests/enforcement/ValidateOrderHookCompressedSnapshotFlowTest.php</file>
            <file>tests/enforcement/InternalErrorFlowTest.php</file>
            <file>tests/enforcement/ValidateOrderHookReplayIdentityTest.php</file>
            <file>tests/enforcement/ValidateOrderHookNonceContractTest.php</file>
            <file>tests/enforcement/ValidateOrderHookPaymentRailFlowTest.php</file>
            <file>tests/enforcement/SnapshotHardeningFlowTest.php</file>
            <file>tests/enforcement/TokenVerifierCritFlowTest.php</file>
            <file>tests/enforcement/TokenVerifierMaxAgeTest.php</file>
            <file>tests/enforcement/BrowserAgentSignatureTest.php</file>
            <file>tests/enforcement/WebmcpCheckoutControllerTest.php</file>
            <file>tests/enforcement/WebmcpChannelMarkTest.php</file>
        </testsuite>
        <!--
          Plan 04 Task 29c (L6b) — tope de lectura del cuerpo con cURL real
          contra un servidor local. No declara stubs de PS.
        -->
        <testsuite name="enforcement-snapshot-http">
            <file>tests/enforcement/SnapshotClientResponseLimitTest.php</file>
            <file>tests/enforcement/JwksCacheCodecTest.php</file>
            <file>tests/enforcement/LineItemAliasesTest.php</file>
            <file>tests/enforcement/CartAgentStorageTest.php</file>
            <file>tests/enforcement/WebserviceGapMiddlewareTest.php</file>
            <file>tests/enforcement/CapabilitiesReporterTest.php</file>
            <file>tests/enforcement/SnapshotClientLayer2BreakerTest.php</file>
            <file>tests/enforcement/ValidateOrderHookLogEscapingTest.php</file>
            <file>tests/enforcement/AgentReasonTest.php</file>
        </testsuite>
        <!--
          A4/A5 (auditoría agent-readiness 2026-09-26) — el emisor de eventos de
          pedido. Estos tests existían y NO corrían: el directorio no estaba
          aquí, así que la fecha de envío que arregla «cumple el 100 %» en C16
          no tenía ninguna red. Directorio entero: sus stubs (`\Order`,
          `\OrderSlip`, `\Context`) se declaran sólo si no existen y conviven
          con los del bootstrap.
        -->
        <testsuite name="hooks">
            <directory>tests/hooks</directory>
        </testsuite>
        <!--
          R2 (2026-09-26) — upgrade 2.3.1. Pasaba y no estaba en ninguna suite:
          lo destapó el gate `tests/meta/TodoTestEstaEnUnaSuiteTest.php`.
        -->
        <testsuite name="upgrade">
            <directory>tests/upgrade</directory>
        </testsuite>
        <!--
          El gate que impide que un `*Test.php` vuelva a quedar fuera de toda
          suite sin que nadie lo vea.
        -->
        <!--
          Sincronización de la cuenta PayPal del módulo `paypal` (202 ecommerce)
          con la plataforma (plan 2026-10-12 F4.1). Lógica con dependencias
          inyectadas: no declara stubs globales de PS.
        -->
        <testsuite name="paypal-sync">
            <directory>tests/PayPalSync</directory>
        </testsuite>
        <testsuite name="meta">
            <directory>tests/meta</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src/AgenticTools</directory>
            <directory suffix=".php">src/Admin</directory>
        </include>
    </source>
</phpunit>
